# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Twitter Login (Playwright browser automation)
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password

# OpenAI — primary AI provider (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-...

# Groq — free fallback AI (https://console.groq.com)
GROQ_API_KEY=gsk_...

# Twitter API v2 (https://developer.twitter.com)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# Safety Settings
SAFE_MODE=false
MAX_CONTROVERSY_LEVEL=8
REQUIRE_MANUAL_REVIEW=true

# Response Settings
RESPONSE_DELAY_MIN=300
RESPONSE_DELAY_MAX=1800
MAX_RESPONSES_PER_HOUR=3
MAX_RESPONSES_PER_USER_PER_DAY=2

# Monitoring Settings
MONITOR_INTERVAL=300
TARGET_USERS=@user1,@user2,@user3
